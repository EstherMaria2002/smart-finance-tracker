# Copia este fichero a .env y cambia los valores.
# Generar secretos:  openssl rand -hex 32

# Firma de los JWT (HS256). Mínimo 32 caracteres.
JWT_SECRET=cambia-esto-en-produccion-minimo-32-caracteres
# Clave compartida backend <-> ML service (cabecera X-Internal-Api-Key).
INTERNAL_API_KEY=cambia-esto-tambien

# Opcionales (por defecto: sft / sft / sft)
# POSTGRES_DB=sft
# POSTGRES_USER=sft
# POSTGRES_PASSWORD=sft
